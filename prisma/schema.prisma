datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SystemStatus {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model StoreResource {
  id        String   @id @default(uuid())
  resource  String
  itemId    String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resource, itemId])
}

model StoreSetting {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}
