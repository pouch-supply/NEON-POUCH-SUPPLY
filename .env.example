# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Neon PostgreSQL Connection String
# Example: postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Worldpay Access Platform Configuration (dashboard.worldpay.com)
WORLDPAY_ENTITY_ID=
WORLDPAY_CHECKOUT_ID=
WORLDPAY_API_USERNAME=
WORLDPAY_API_PASSWORD=
WORLDPAY_ENVIRONMENT=live
WORLDPAY_BASE_URL=https://access.worldpay.com
# WORLDPAY_WEBHOOK_SECRET= (Optional - only required if signed webhooks are enabled in Worldpay)

